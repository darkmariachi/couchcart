{
  "name": "couchcart",
  "version": "0.1.1",
  "description": "Couchcart: a couch-friendly launcher and save-sync client for RomM libraries, using RetroArch for emulation",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --windowed",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript docs/romm-openapi.json -o src/main/romm/schema.d.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "notices": "node scripts/third-party-notices.mjs",
    "format:check": "prettier --check .",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "steam-art": "electron scripts/make-steam-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@tanstack/react-query": "^5.104.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "author": "Couchcart contributors",
  "license": "MIT",
  "homepage": "https://github.com/darkmariachi/couchcart",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkmariachi/couchcart.git"
  },
  "desktopName": "couchcart.desktop"
}
